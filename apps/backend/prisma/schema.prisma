generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// আপাতত এটি কমেন্ট করে রাখুন
// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgcrypto, vector, postgis]
}

// 2.B.01 Tenants Table
model Tenant {
  id                 String              @id @default(uuid())
  name               String
  subdomain          String              @unique
  logoUrl            String?             @map("logo_url")
  isActive           Boolean             @default(true) @map("is_active")
  subscriptionStatus String              @default("ACTIVE") @map("subscription_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at") // 2.I.02 Soft Delete

  subscription       TenantSubscription?
  invoices           SaasInvoice[]
  profiles           Profile[]
  referral           ReferralLinkage?
  admissionSessions  AdmissionSession[]
  classes            Class[]
  students           Student[]
  staff              StaffProfile[]
  chartOfAccounts    ChartOfAccount[]
  leaveTypes         LeaveType[]
  kycDocuments       KycDocument[]

  // Division 7 Relations
  curriculumPlans    CurriculumPlan[]
  subjects           Subject[]
  syllabusLogs       SyllabusLog[]
  questionBanks      QuestionBank[]
  questionBlueprints QuestionBlueprint[]
  teacherTrainings   TeacherTraining[]
  learningResources  LearningResource[]
  homeworks          Homework[]
  onlineExams        OnlineExam[]

  @@map("tenants")
}

// 2.B.04 Plans Table
model Plan {
  id            String               @id @default(uuid())
  name          String               @unique
  priceMonthly  Float                @map("price_monthly")
  featuresConfig Json                @map("features_config")
  subscriptions TenantSubscription[]

  @@map("plans")
}

// 2.B.05 Tenant Subscriptions
model TenantSubscription {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  planId     String   @map("plan_id")
  startDate  DateTime @default(now()) @map("start_date")
  expiryDate DateTime @map("expiry_date")
  autoRenew  Boolean  @default(true) @map("auto_renew")

  plan       Plan     @relation(fields: [planId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
}

// 2.B.06 SaaS Invoices
model SaasInvoice {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  amount    Float
  status    String   // PAID, PENDING, FAILED
  issuedAt  DateTime @default(now()) @map("issued_at")
  paidAt    DateTime? @map("paid_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("saas_invoices")
}

// 2.C.01 Users Table
model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique // PII: Field encryption enabled via pgcrypto
  passwordHash String   @map("password_hash")
  phone        String?  // PII: Field encryption enabled via pgcrypto
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // 2.I.02 Soft Delete

  profiles      Profile[]
  refreshTokens RefreshToken[]
  platformAdmin PlatformAdmin?
  resellerProfile ResellerProfile?
  student         Student?
  guardian        Guardian?
  staffProfile    StaffProfile?

  @@map("users")
}

// 2.C.02 Profiles Table (Multi-role support)
model Profile {
  id        String   @id @default(uuid()) @map("profile_id")
  userId    String   @map("user_id")
  tenantId  String   @map("school_id")
  role      UserRole 
  
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId]) // 2.C.07 Composite index
  @@map("profiles")
}

// 2.C.04 Refresh Tokens
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// 2.E.01 Platform Admins
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

// 2.E.02 Global Configs
model GlobalConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_configs")
}

// 2.E.03 Platform Audit Logs
model PlatformAuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  target    String?  // e.g., "Tenant: 123"
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  admin     PlatformAdmin @relation(fields: [adminId], references: [id])

  @@map("platform_audit_logs")
}

// 2.E.07 Reseller Profiles
model ResellerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  commissionRate Float    @default(10.0) @map("commission_rate") // Percentage
  totalEarnings  Float    @default(0.0) @map("total_earnings")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  referrals ReferralLinkage[]

  @@map("reseller_profiles")
}

// 2.E.08 Referral Linkages
model ReferralLinkage {
  id           String   @id @default(uuid())
  resellerId   String   @map("reseller_id")
  tenantId     String   @unique @map("tenant_id")
  referralCode String   @map("referral_code")
  linkedAt     DateTime @default(now()) @map("linked_at")

  reseller     ResellerProfile @relation(fields: [resellerId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@map("referral_linkages")
}

// 2.E.10 Marketing Templates
model MarketingTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String   // e.g., "Admission", "Festival"
  contentHtml  String   @map("content_html")
  variables    Json?
  thumbnailUrl String?  @map("thumbnail_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("marketing_templates")
}

// 2.C.06 Permissions
model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., "view:fees", "create:student"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// 2.C.08 OTP Logs
model OtpLog {
  id        String   @id @default(uuid())
  phone     String   // PII: Encrypted
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attemptCount Int     @default(0) @map("attempt_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_logs")
}

// 2.F.01 Admission Sessions
model AdmissionSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "2024-2025"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  students  Student[]
  curriculumPlans CurriculumPlan[]

  @@map("admission_sessions")
}

// 2.F.02 Classes
model Class {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "Grade 1"
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sections  Section[]
  curriculumPlans CurriculumPlan[]

  @@map("classes")
}

// 2.F.03 Sections
model Section {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  name      String   // e.g., "Section A"
  deletedAt DateTime? @map("deleted_at")
  
  class     Class    @relation(fields: [classId], references: [id])
  students  Student[]
  syllabusLogs SyllabusLog[]

  @@map("sections")
}

// 2.F.04 Students
model Student {
  id                String   @id @default(uuid())
  tenantId          String   @map("school_id") // 2.F.05 FK to School
  admissionSessionId String  @map("session_id")
  sectionId         String   @map("section_id")
  userId            String?  @unique @map("user_id")
  
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  admissionNo       String   @map("admission_no")
  rollNo            Int?     @map("roll_no") // 2.F.10 Auto-gen via trigger
  deletedAt         DateTime? @map("deleted_at") // 2.I.02 Soft Delete
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  admissionSession  AdmissionSession @relation(fields: [admissionSessionId], references: [id])
  section           Section  @relation(fields: [sectionId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  
  guardians         ParentStudentMapping[]
  healthProfile     HealthProfile?
  homeworkSubmissions HomeworkSubmission[]

  @@unique([admissionNo, tenantId]) // 2.F.09 Unique constraint
  @@map("students")
}

// 2.F.06 Guardians
model Guardian {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  
  user      User     @relation(fields: [userId], references: [id])
  students  ParentStudentMapping[]

  @@map("guardians")
}

// 2.F.07 Parent Student Mapping
model ParentStudentMapping {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  relationship String // e.g., "Father", "Mother"
  
  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("parent_student_mappings")
}

// 2.F.08 Staff Profiles
model StaffProfile {
  id           String   @id @default(uuid())
  tenantId     String   @map("school_id")
  userId       String   @unique @map("user_id")
  designation  String
  department   String?
  joiningDate  DateTime @map("joining_date")
  deletedAt    DateTime? @map("deleted_at")
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
  syllabusLogs SyllabusLog[]
  trainingAttendances TrainingAttendance[]

  @@map("staff_profiles")
}

// 2.H.06 Finance: Chart of Accounts
model ChartOfAccount {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  code      String
  name      String
  type      String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

// 2.H.07 HR: Leave Types
model LeaveType {
  id          String   @id @default(uuid())
  tenantId    String   @map("school_id")
  name        String
  code        String
  daysAllowed Int      @default(0) @map("days_allowed")
  isPaid      Boolean  @default(true) @map("is_paid")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("leave_types")
}

// 2.I.01 Health Profiles (Encrypted)
model HealthProfile {
  id               String   @id @default(uuid())
  studentId        String   @unique @map("student_id")
  bloodGroup       String?  @map("blood_group")
  
  // PII/Sensitive Data - Encrypted at Application Level (AES-256-GCM)
  allergies        String?  
  medicalHistory   String?  @map("medical_history")
  medications      String?
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student          Student  @relation(fields: [studentId], references: [id])

  @@map("health_profiles")
}

// 2.I.07 KYC Documents
model KycDocument {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  documentType    String    @map("document_type") // e.g., "TRADE_LICENSE", "NID"
  documentUrl     String    @map("document_url")  // Secure Storage URL
  status          String    @default("PENDING")   // PENDING, VERIFIED, REJECTED
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@map("kyc_documents")
}

// 2.I.06 Table Audit Logs (To prevent drift)
model TableAuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  operation String
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("table_audit_logs")
}

// 7.A.01 Curriculum Plans
model CurriculumPlan {
  id              String   @id @default(uuid())
  tenantId        String   @map("school_id")
  classId         String   @map("class_id")
  subjectId       String   @map("subject_id")
  academicYearId  String   @map("academic_year_id")
  version         String   @default("1.0") // 7.A.05
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  class           Class            @relation(fields: [classId], references: [id])
  academicYear    AdmissionSession @relation(fields: [academicYearId], references: [id])
  subject         Subject          @relation(fields: [subjectId], references: [id])

  chapters        Chapter[]

  @@map("curriculum_plans")
  @@unique([tenantId, classId, subjectId, academicYearId, version])
}

model Subject {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String
  code      String?
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  curriculumPlans CurriculumPlan[]
  questionBank    QuestionBank[]
  learningResources LearningResource[]
  onlineExams     OnlineExam[]
  homeworks       Homework[]

  @@map("subjects")
}

// 7.A.02 Chapters
model Chapter {
  id                  String   @id @default(uuid())
  planId              String   @map("plan_id")
  chapterNumber       Int      @map("chapter_number")
  name                String
  description         String?
  targetCompletionDate DateTime? @map("target_completion_date") // 7.A.06

  plan                CurriculumPlan @relation(fields: [planId], references: [id])
  topics              Topic[]
  learningResources   LearningResource[]

  @@map("chapters")
}

// 7.A.03 Topics
model Topic {
  id             String   @id @default(uuid())
  chapterId      String   @map("chapter_id")
  name           String
  estimatedHours Float    @map("estimated_hours")
  orderIndex     Int      @default(0) @map("order_index") // For Drag-and-drop 7.A.09

  chapter        Chapter  @relation(fields: [chapterId], references: [id])
  outcomes       LearningOutcome[]
  syllabusLogs   SyllabusLog[]
  learningResources LearningResource[]

  @@map("topics")
}

// 7.A.07 Learning Outcomes
model LearningOutcome {
  id          String   @id @default(uuid())
  topicId     String   @map("topic_id")
  description String

  topic       Topic    @relation(fields: [topicId], references: [id])

  @@map("learning_outcomes")
}

// 7.B.01 Syllabus Logs
model SyllabusLog {
  id             String   @id @default(uuid())
  tenantId       String   @map("school_id")
  topicId        String   @map("topic_id")
  teacherId      String   @map("teacher_id") // StaffProfile
  sectionId      String   @map("section_id")
  completionDate DateTime @map("completion_date")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  topic          Topic        @relation(fields: [topicId], references: [id]) // Removed Cascade for 7.A.10 Integrity
  teacher        StaffProfile @relation(fields: [teacherId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])

  @@map("syllabus_logs")
}

// 7.C.01 Question Bank
model QuestionBank {
  id          String   @id @default(uuid())
  tenantId    String   @map("school_id")
  subjectId   String   @map("subject_id")
  topicTag    String?  @map("topic_tag")
  topicId     String?  @map("topic_id")
  difficulty  String   // Easy, Medium, Hard
  marks       Int
  type        QuestionType
  content     String   // HTML/Markdown
  imageUrl    String?  @map("image_url")
  bloomsLevel BloomsLevel? @map("blooms_level")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])

  @@map("question_bank")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

enum BloomsLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

// 7.D.01 Question Blueprints
model QuestionBlueprint {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  title     String
  structure Json     // Rules: {"Easy": "40%", ...}
  totalMarks Int     @map("total_marks")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("question_blueprints")
}

// 7.F.01 Teacher Trainings
model TeacherTraining {
  id             String   @id @default(uuid())
  tenantId       String   @map("school_id")
  title          String
  date           DateTime
  resourcePerson String?  @map("resource_person")
  description    String?

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  attendances    TrainingAttendance[]

  @@map("teacher_trainings")
}

model TrainingAttendance {
  id         String   @id @default(uuid())
  trainingId String   @map("training_id")
  staffId    String   @map("staff_id")
  status     String   // PRESENT, ABSENT
  feedback   String?  // 7.F.03
  rating     Int?     // 7.F.03

  training   TeacherTraining @relation(fields: [trainingId], references: [id])
  staff      StaffProfile    @relation(fields: [staffId], references: [id])

  @@unique([trainingId, staffId])
  @@map("training_attendance")
}

// 7.G.01 Learning Resources
model LearningResource {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  title     String
  type      ResourceType
  url       String
  subjectId String?  @map("subject_id")
  chapterId String?  @map("chapter_id")
  topicId   String?  @map("topic_id")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  topic     Topic?   @relation(fields: [topicId], references: [id])

  @@map("learning_resources")
}

enum ResourceType {
  VIDEO
  PDF
  LINK
  AUDIO
}

// 7.H Homework
model Homework {
  id             String   @id @default(uuid())
  tenantId       String   @map("school_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  subjectId      String   @map("subject_id") // Should reference Subject model now
  teacherId      String   @map("teacher_id")
  title          String
  description    String?
  dueDate        DateTime @map("due_date")
  rubric         Json?    // 7.H.01

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  subject        Subject  @relation(fields: [subjectId], references: [id])
  // ... other relations
  submissions    HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id         String   @id @default(uuid())
  homeworkId String   @map("homework_id")
  studentId  String   @map("student_id")
  fileUrl    String?  @map("file_url")
  status     String   // SUBMITTED, REDO, GRADED
  marks      Float?
  feedback   String?  // Text
  audioFeedbackUrl String? @map("audio_feedback_url") // 7.H.04
  annotations Json?   // 7.H.02 (Serialized annotations)

  homework   Homework @relation(fields: [homeworkId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@map("homework_submissions")
}

// 7.E Online Assessment
model OnlineExam {
  id              String   @id @default(uuid())
  tenantId        String   @map("school_id")
  subjectId       String   @map("subject_id")
  title           String
  startTime       DateTime @map("start_time")
  endTime         DateTime @map("end_time")
  durationMinutes Int      @map("duration_minutes")

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  subject         Subject  @relation(fields: [subjectId], references: [id])

  @@map("online_exams")
}

// 2.C.03 Roles Enum
enum UserRole {
  SUPER_ADMIN
  ADMIN // School Owner
  HEADMASTER
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
  PARENT
  DRIVER
  AGENT
  CUSTOMER_CARE
  HOSTEL_SUPER
  LIBRARIAN
  SHOP_KEEPER
  MCM
  SUPPLIER
}