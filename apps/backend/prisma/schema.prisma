generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// আপাতত এটি কমেন্ট করে রাখুন
// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgcrypto, vector, postgis]
}

// 2.B.01 Tenants Table
model Tenant {
  id                 String              @id @default(uuid())
  name               String
  subdomain          String              @unique
  logoUrl            String?             @map("logo_url")
  isActive           Boolean             @default(true) @map("is_active")
  subscriptionStatus String              @default("ACTIVE") @map("subscription_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at") // 2.I.02 Soft Delete

  subscription       TenantSubscription?
  invoices           SaasInvoice[]
  profiles           Profile[]
  referral           ReferralLinkage?
  admissionSessions  AdmissionSession[]
  classes            Class[]
  students           Student[]
  staff              StaffProfile[]
  chartOfAccounts    ChartOfAccount[]
  leaveTypes         LeaveType[]
  kycDocuments       KycDocument[]

  // Timetable Relations
  subjects           Subject[]
  rooms              Room[]
  timeSlots          TimeSlot[]
  routineEntries     RoutineEntry[]

  @@map("tenants")
}

// 2.B.04 Plans Table
model Plan {
  id            String               @id @default(uuid())
  name          String               @unique
  priceMonthly  Float                @map("price_monthly")
  featuresConfig Json                @map("features_config")
  subscriptions TenantSubscription[]

  @@map("plans")
}

// 2.B.05 Tenant Subscriptions
model TenantSubscription {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  planId     String   @map("plan_id")
  startDate  DateTime @default(now()) @map("start_date")
  expiryDate DateTime @map("expiry_date")
  autoRenew  Boolean  @default(true) @map("auto_renew")

  plan       Plan     @relation(fields: [planId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
}

// 2.B.06 SaaS Invoices
model SaasInvoice {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  amount    Float
  status    String   // PAID, PENDING, FAILED
  issuedAt  DateTime @default(now()) @map("issued_at")
  paidAt    DateTime? @map("paid_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("saas_invoices")
}

// 2.C.01 Users Table
model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique // PII: Field encryption enabled via pgcrypto
  passwordHash String   @map("password_hash")
  phone        String?  // PII: Field encryption enabled via pgcrypto
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // 2.I.02 Soft Delete

  profiles      Profile[]
  refreshTokens RefreshToken[]
  platformAdmin PlatformAdmin?
  resellerProfile ResellerProfile?
  student         Student?
  guardian        Guardian?
  staffProfile    StaffProfile?

  @@map("users")
}

// 2.C.02 Profiles Table (Multi-role support)
model Profile {
  id        String   @id @default(uuid()) @map("profile_id")
  userId    String   @map("user_id")
  tenantId  String   @map("school_id")
  role      UserRole 
  
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId]) // 2.C.07 Composite index
  @@map("profiles")
}

// 2.C.04 Refresh Tokens
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// 2.E.01 Platform Admins
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

// 2.E.02 Global Configs
model GlobalConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_configs")
}

// 2.E.03 Platform Audit Logs
model PlatformAuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  target    String?  // e.g., "Tenant: 123"
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  admin     PlatformAdmin @relation(fields: [adminId], references: [id])

  @@map("platform_audit_logs")
}

// 2.E.07 Reseller Profiles
model ResellerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  commissionRate Float    @default(10.0) @map("commission_rate") // Percentage
  totalEarnings  Float    @default(0.0) @map("total_earnings")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  referrals ReferralLinkage[]

  @@map("reseller_profiles")
}

// 2.E.08 Referral Linkages
model ReferralLinkage {
  id           String   @id @default(uuid())
  resellerId   String   @map("reseller_id")
  tenantId     String   @unique @map("tenant_id")
  referralCode String   @map("referral_code")
  linkedAt     DateTime @default(now()) @map("linked_at")

  reseller     ResellerProfile @relation(fields: [resellerId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@map("referral_linkages")
}

// 2.E.10 Marketing Templates
model MarketingTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String   // e.g., "Admission", "Festival"
  contentHtml  String   @map("content_html")
  variables    Json?
  thumbnailUrl String?  @map("thumbnail_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("marketing_templates")
}

// 2.C.06 Permissions
model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., "view:fees", "create:student"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// 2.C.08 OTP Logs
model OtpLog {
  id        String   @id @default(uuid())
  phone     String   // PII: Encrypted
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attemptCount Int     @default(0) @map("attempt_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_logs")
}

// 2.F.01 Admission Sessions
model AdmissionSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "2024-2025"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  students  Student[]

  @@map("admission_sessions")
}

// 2.F.02 Classes
model Class {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "Grade 1"
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sections  Section[]
  routineEntries RoutineEntry[]
  homeworks Homework[]
  curriculumPlans CurriculumPlan[]

  @@map("classes")
}

// 2.F.03 Sections
model Section {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  name      String   // e.g., "Section A"
  deletedAt DateTime? @map("deleted_at")
  
  class     Class    @relation(fields: [classId], references: [id])
  students  Student[]
  routineEntries RoutineEntry[]

  @@map("sections")
}

// 2.F.04 Students
model Student {
  id                String   @id @default(uuid())
  tenantId          String   @map("school_id") // 2.F.05 FK to School
  admissionSessionId String  @map("session_id")
  sectionId         String   @map("section_id")
  userId            String?  @unique @map("user_id")
  
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  admissionNo       String   @map("admission_no")
  rollNo            Int?     @map("roll_no") // 2.F.10 Auto-gen via trigger
  deletedAt         DateTime? @map("deleted_at") // 2.I.02 Soft Delete
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  admissionSession  AdmissionSession @relation(fields: [admissionSessionId], references: [id])
  section           Section  @relation(fields: [sectionId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  
  guardians         ParentStudentMapping[]
  healthProfile     HealthProfile?
  liveAttendanceLogs LiveAttendanceLog[]
  homeworkSubmissions HomeworkSubmission[]
  hallTickets       HallTicket[]

  @@unique([admissionNo, tenantId]) // 2.F.09 Unique constraint
  @@map("students")
}

model StudentSequence {
  id        String @id @default(uuid())
  tenantId  String @map("school_id")
  year      Int
  lastSeq   Int    @default(0) @map("last_seq")

  @@unique([tenantId, year])
  @@map("student_sequences")
}

// 2.F.06 Guardians
model Guardian {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  
  user      User     @relation(fields: [userId], references: [id])
  students  ParentStudentMapping[]

  @@map("guardians")
}

// 2.F.07 Parent Student Mapping
model ParentStudentMapping {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  relationship String // e.g., "Father", "Mother"
  
  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("parent_student_mappings")
}

// 2.F.08 Staff Profiles
model StaffProfile {
  id           String   @id @default(uuid())
  tenantId     String   @map("school_id")
  userId       String   @unique @map("user_id")
  designation  String
  department   String?
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  joiningDate  DateTime @map("joining_date")
  deletedAt    DateTime? @map("deleted_at")
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  // Relations for Timetable
  routineEntries RoutineEntry[]
  substitutionsAsOriginal RoutineSubstitution[] @relation("OriginalTeacher")
  substitutionsAsSubstitute RoutineSubstitution[] @relation("SubstituteTeacher")
  extraDutyLogs StaffExtraDutyLog[]
  leaveApplications LeaveApplication[]
  homeworks Homework[]

  @@map("staff_profiles")
}

// 2.H.06 Finance: Chart of Accounts
model ChartOfAccount {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  code      String
  name      String
  type      String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

// 2.H.07 HR: Leave Types
model LeaveType {
  id          String   @id @default(uuid())
  tenantId    String   @map("school_id")
  name        String
  code        String
  daysAllowed Int      @default(0) @map("days_allowed")
  isPaid      Boolean  @default(true) @map("is_paid")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("leave_types")
}

// 2.I.01 Health Profiles (Encrypted)
model HealthProfile {
  id               String   @id @default(uuid())
  studentId        String   @unique @map("student_id")
  bloodGroup       String?  @map("blood_group")
  
  // PII/Sensitive Data - Encrypted at Application Level (AES-256-GCM)
  allergies        String?  
  medicalHistory   String?  @map("medical_history")
  medications      String?
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student          Student  @relation(fields: [studentId], references: [id])

  @@map("health_profiles")
}

// 2.I.07 KYC Documents
model KycDocument {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  documentType    String    @map("document_type") // e.g., "TRADE_LICENSE", "NID"
  documentUrl     String    @map("document_url")  // Secure Storage URL
  status          String    @default("PENDING")   // PENDING, VERIFIED, REJECTED
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@map("kyc_documents")
}

// 2.I.06 Table Audit Logs (To prevent drift)
model TableAuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  operation String
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("table_audit_logs")
}

// Timetable / Academic Module

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Subject {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String
  code      String?
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  routineEntries RoutineEntry[]
  homeworks Homework[]
  curriculumPlans CurriculumPlan[]

  @@map("subjects")
}

model Room {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String
  capacity  Int
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  routineEntries RoutineEntry[]

  @@map("rooms")
}

model TimeSlot {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  startTime String   @map("start_time") // e.g., "09:00"
  endTime   String   @map("end_time")   // e.g., "10:00"
  label     String?  // e.g., "Period 1"
  type      String?  // e.g., "CLASS", "BREAK"
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  routineEntries RoutineEntry[]

  @@map("time_slots")
}

model RoutineEntry {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id") // Renamed from tenantId to match service

  dayOfWeek DayOfWeek @map("day_of_week")

  classId   String    @map("class_id")
  sectionId String    @map("section_id")
  subjectId String    @map("subject_id")
  teacherId String    @map("teacher_id") // Maps to StaffProfile
  roomId    String?   @map("room_id")
  slotId    String    @map("slot_id")

  // Live Class Fields
  meetingLink String? @map("meeting_link")
  isLive      Boolean @default(false) @map("is_live")

  tenant    Tenant    @relation(fields: [schoolId], references: [id])
  class     Class     @relation(fields: [classId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   StaffProfile @relation(fields: [teacherId], references: [id])
  room      Room?     @relation(fields: [roomId], references: [id])
  slot      TimeSlot  @relation(fields: [slotId], references: [id])
  liveAttendanceLogs LiveAttendanceLog[]
  classRecordings    ClassRecording[]
  substitutions      RoutineSubstitution[]
  lessonPlans        LessonPlan[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("routine_entries")
}

model LiveAttendanceLog {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  routineEntryId String       @map("routine_entry_id")
  joinTime       DateTime     @default(now()) @map("join_time")
  leaveTime      DateTime?    @map("leave_time")

  student        Student      @relation(fields: [studentId], references: [id])
  routineEntry   RoutineEntry @relation(fields: [routineEntryId], references: [id])

  @@map("live_attendance_logs")
}

model ClassRecording {
  id             String   @id @default(uuid())
  routineEntryId String   @map("routine_entry_id")
  vodUrl         String   @map("vod_url")
  duration       Int      // In minutes or seconds
  createdAt      DateTime @default(now()) @map("created_at")

  routineEntry   RoutineEntry @relation(fields: [routineEntryId], references: [id])

  @@map("class_recordings")
}

model RoutineSubstitution {
  id                  String   @id @default(uuid())
  routineEntryId      String   @map("routine_entry_id")
  originalTeacherId   String   @map("original_teacher_id")
  substituteTeacherId String?  @map("substitute_teacher_id")
  date                DateTime
  status              String   @default("PENDING") // PENDING, ASSIGNED
  createdAt           DateTime @default(now()) @map("created_at")

  routineEntry        RoutineEntry @relation(fields: [routineEntryId], references: [id])
  originalTeacher     StaffProfile @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacher   StaffProfile? @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])

  @@map("routine_substitutions")
}

model StaffExtraDutyLog {
  id          String   @id @default(uuid())
  teacherId   String   @map("teacher_id")
  hoursWorked Float    @map("hours_worked")
  type        String   // 'SUBSTITUTION', 'EXAM_DUTY'
  date        DateTime @default(now())
  details     Json?

  teacher     StaffProfile @relation(fields: [teacherId], references: [id])

  @@map("staff_extra_duty_logs")
}

model LeaveApplication {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED

  teacher   StaffProfile @relation(fields: [teacherId], references: [id])
  @@map("leave_applications")
}

model Homework {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  subjectId   String   @map("subject_id")
  teacherId   String   @map("teacher_id")
  title       String
  description String?
  dueDate     DateTime @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")

  class       Class        @relation(fields: [classId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     StaffProfile @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id          String   @id @default(uuid())
  homeworkId  String   @map("homework_id")
  studentId   String   @map("student_id")
  fileUrl     String?  @map("file_url")
  grade       Int?     // 1-5 or 0-100
  status      String   @default("PENDING") // PENDING, SUBMITTED, GRADED
  submittedAt DateTime @default(now()) @map("submitted_at")

  homework    Homework @relation(fields: [homeworkId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@map("homework_submissions")
}

model CurriculumPlan {
  id                   String       @id @default(uuid())
  classId              String       @map("class_id")
  subjectId            String       @map("subject_id")
  chapterName          String       @map("chapter_name")
  totalLessons         Int          @map("total_lessons")
  status               String       @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  actualCompletionDate DateTime?    @map("actual_completion_date")
  createdAt            DateTime     @default(now()) @map("created_at")

  class                Class        @relation(fields: [classId], references: [id])
  subject              Subject      @relation(fields: [subjectId], references: [id])
  lessons              LessonPlan[]

  @@map("curriculum_plans")
}

model LessonPlan {
  id               String         @id @default(uuid())
  curriculumPlanId String         @map("curriculum_plan_id")
  routineEntryId   String?        @map("routine_entry_id")
  topic            String
  status           String         @default("PENDING") // PENDING, COMPLETED
  completionDate   DateTime?      @map("completion_date")

  curriculumPlan   CurriculumPlan @relation(fields: [curriculumPlanId], references: [id])
  routineEntry     RoutineEntry?  @relation(fields: [routineEntryId], references: [id])

  @@map("lesson_plans")
}

// 6.A.01: Exam Terms Table
model ExamTerm {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  weightage_percent Float
  start_date        DateTime
  end_date          DateTime
  is_active         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exams             Exam[]

  @@unique([tenantId, name])
  @@map("exam_terms")
}

// 6.A.02: Exam Types Master
model ExamType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]

  @@map("exam_types")
}

// 6.A.03: Exam Table
model Exam {
  id          String   @id @default(uuid())
  classId     String
  subjectId   String
  termId      String
  typeId      String
  examGroupId String?
  maxMarks    Float
  examDate    DateTime
  is_locked   Boolean  @default(false)
  is_published Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  term      ExamTerm   @relation(fields: [termId], references: [id])
  type      ExamType   @relation(fields: [typeId], references: [id])
  examGroup ExamGroup? @relation(fields: [examGroupId], references: [id])

  @@map("exams")
}

// 6.A.04: Exam Group
model ExamGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  exams     Exam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hallTickets HallTicket[]

  @@map("exam_groups")
}

// 6.A.07: Hall Tickets Table
model HallTicket {
  id          String    @id @default(uuid())
  studentId   String
  examGroupId String
  roll_no     String
  exam_center String
  seat_number String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id])
  examGroup   ExamGroup @relation(fields: [examGroupId], references: [id])

  @@unique([studentId, examGroupId])
  @@map("hall_tickets")
}

// 2.C.03 Roles Enum
enum UserRole {
  SUPER_ADMIN
  ADMIN // School Owner
  HEADMASTER
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
  PARENT
  DRIVER
  AGENT
  CUSTOMER_CARE
  HOSTEL_SUPER
  LIBRARIAN
  SHOP_KEEPER
  MCM
  SUPPLIER
}
