generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// আপাতত এটি কমেন্ট করে রাখুন
// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./ERD.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgcrypto, vector, postgis]
}

// 2.B.01 Tenants Table
model Tenant {
  id                 String              @id @default(uuid())
  name               String
  subdomain          String              @unique
  logoUrl            String?             @map("logo_url")
  isActive           Boolean             @default(true) @map("is_active")
  subscriptionStatus String              @default("ACTIVE") @map("subscription_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at") // 2.I.02 Soft Delete

  subscription       TenantSubscription?
  invoices           SaasInvoice[]
  profiles           Profile[]
  referral           ReferralLinkage?
  admissionSessions  AdmissionSession[]
  classes            Class[]
  students           Student[]
  staff              StaffProfile[]
  chartOfAccounts    ChartOfAccount[]
  leaveTypes         LeaveType[]
  kycDocuments       KycDocument[]
  gradingScales      GradingScale[]

  defaultGradingScaleId String? @map("default_grading_scale_id")
  defaultGradingScale   GradingScale? @relation("DefaultGradingScale", fields: [defaultGradingScaleId], references: [id])

  subjects           Subject[]
  gradingMaps        SubjectGradingMap[]
  exams              Exam[]
  examTerms          ExamTerm[]
  marksheetTemplates MarksheetTemplate[]

  @@map("tenants")
}

// 2.B.04 Plans Table
model Plan {
  id            String               @id @default(uuid())
  name          String               @unique
  priceMonthly  Float                @map("price_monthly")
  featuresConfig Json                @map("features_config")
  subscriptions TenantSubscription[]

  @@map("plans")
}

// 2.B.05 Tenant Subscriptions
model TenantSubscription {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  planId     String   @map("plan_id")
  startDate  DateTime @default(now()) @map("start_date")
  expiryDate DateTime @map("expiry_date")
  autoRenew  Boolean  @default(true) @map("auto_renew")

  plan       Plan     @relation(fields: [planId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
}

// 2.B.06 SaaS Invoices
model SaasInvoice {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  amount    Float
  status    String   // PAID, PENDING, FAILED
  issuedAt  DateTime @default(now()) @map("issued_at")
  paidAt    DateTime? @map("paid_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("saas_invoices")
}

// 2.C.01 Users Table
model User {
  id           String   @id @default(uuid()) @map("user_id")
  email        String   @unique // PII: Field encryption enabled via pgcrypto
  passwordHash String   @map("password_hash")
  phone        String?  // PII: Field encryption enabled via pgcrypto
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // 2.I.02 Soft Delete

  profiles      Profile[]
  refreshTokens RefreshToken[]
  platformAdmin PlatformAdmin?
  resellerProfile ResellerProfile?
  student         Student?
  guardian        Guardian?
  staffProfile    StaffProfile?

  @@map("users")
}

// 2.C.02 Profiles Table (Multi-role support)
model Profile {
  id        String   @id @default(uuid()) @map("profile_id")
  userId    String   @map("user_id")
  tenantId  String   @map("school_id")
  role      UserRole 
  
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId]) // 2.C.07 Composite index
  @@map("profiles")
}

// 2.C.04 Refresh Tokens
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// 2.E.01 Platform Admins
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

// 2.E.02 Global Configs
model GlobalConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_configs")
}

// 2.E.03 Platform Audit Logs
model PlatformAuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  target    String?  // e.g., "Tenant: 123"
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  admin     PlatformAdmin @relation(fields: [adminId], references: [id])

  @@map("platform_audit_logs")
}

// 2.E.07 Reseller Profiles
model ResellerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  commissionRate Float    @default(10.0) @map("commission_rate") // Percentage
  totalEarnings  Float    @default(0.0) @map("total_earnings")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  referrals ReferralLinkage[]

  @@map("reseller_profiles")
}

// 2.E.08 Referral Linkages
model ReferralLinkage {
  id           String   @id @default(uuid())
  resellerId   String   @map("reseller_id")
  tenantId     String   @unique @map("tenant_id")
  referralCode String   @map("referral_code")
  linkedAt     DateTime @default(now()) @map("linked_at")

  reseller     ResellerProfile @relation(fields: [resellerId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@map("referral_linkages")
}

// 2.E.10 Marketing Templates
model MarketingTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String   // e.g., "Admission", "Festival"
  contentHtml  String   @map("content_html")
  variables    Json?
  thumbnailUrl String?  @map("thumbnail_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("marketing_templates")
}

// 2.C.06 Permissions
model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., "view:fees", "create:student"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// 2.C.08 OTP Logs
model OtpLog {
  id        String   @id @default(uuid())
  phone     String   // PII: Encrypted
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attemptCount Int     @default(0) @map("attempt_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_logs")
}

// 2.F.01 Admission Sessions
model AdmissionSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "2024-2025"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  students  Student[]

  @@map("admission_sessions")
}

// 2.F.02 Classes
model Class {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String   // e.g., "Grade 1"
  deletedAt DateTime? @map("deleted_at")
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sections  Section[]
  gradingMaps SubjectGradingMap[]
  exams       Exam[]
  markEntryStatuses MarkEntryStatus[]

  templateId   String?            @map("template_id")
  template     MarksheetTemplate? @relation(fields: [templateId], references: [id])

  @@map("classes")
}

// 2.F.03 Sections
model Section {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  name      String   // e.g., "Section A"
  deletedAt DateTime? @map("deleted_at")
  
  class     Class    @relation(fields: [classId], references: [id])
  students  Student[]

  classTeacherId String?       @map("class_teacher_id")
  classTeacher   StaffProfile? @relation(fields: [classTeacherId], references: [id])

  @@map("sections")
}

// 2.F.04 Students
model Student {
  id                String   @id @default(uuid())
  tenantId          String   @map("school_id") // 2.F.05 FK to School
  admissionSessionId String  @map("session_id")
  sectionId         String   @map("section_id")
  userId            String?  @unique @map("user_id")
  
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  admissionNo       String   @map("admission_no")
  rollNo            Int?     @map("roll_no") // 2.F.10 Auto-gen via trigger
  deletedAt         DateTime? @map("deleted_at") // 2.I.02 Soft Delete
  
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  admissionSession  AdmissionSession @relation(fields: [admissionSessionId], references: [id])
  section           Section  @relation(fields: [sectionId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  
  guardians         ParentStudentMapping[]
  healthProfile     HealthProfile?
  marks             StudentMark[]
  resultSummaries   ResultSummary[]

  @@unique([admissionNo, tenantId]) // 2.F.09 Unique constraint
  @@map("students")
}

// 2.F.06 Guardians
model Guardian {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  
  user      User     @relation(fields: [userId], references: [id])
  students  ParentStudentMapping[]

  @@map("guardians")
}

// 2.F.07 Parent Student Mapping
model ParentStudentMapping {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  guardianId String   @map("guardian_id")
  relationship String // e.g., "Father", "Mother"
  
  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("parent_student_mappings")
}

// 2.F.08 Staff Profiles
model StaffProfile {
  id           String   @id @default(uuid())
  tenantId     String   @map("school_id")
  userId       String   @unique @map("user_id")
  designation  String
  department   String?
  joiningDate  DateTime @map("joining_date")
  deletedAt    DateTime? @map("deleted_at")
  
  signatureUrl String?  @map("signature_url")
  sections     Section[]

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@map("staff_profiles")
}

// 2.H.06 Finance: Chart of Accounts
model ChartOfAccount {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  code      String
  name      String
  type      String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

// 2.H.07 HR: Leave Types
model LeaveType {
  id          String   @id @default(uuid())
  tenantId    String   @map("school_id")
  name        String
  code        String
  daysAllowed Int      @default(0) @map("days_allowed")
  isPaid      Boolean  @default(true) @map("is_paid")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("leave_types")
}

// 2.I.01 Health Profiles (Encrypted)
model HealthProfile {
  id               String   @id @default(uuid())
  studentId        String   @unique @map("student_id")
  bloodGroup       String?  @map("blood_group")
  
  // PII/Sensitive Data - Encrypted at Application Level (AES-256-GCM)
  allergies        String?  
  medicalHistory   String?  @map("medical_history")
  medications      String?
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student          Student  @relation(fields: [studentId], references: [id])

  @@map("health_profiles")
}

// 2.I.07 KYC Documents
model KycDocument {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  documentType    String    @map("document_type") // e.g., "TRADE_LICENSE", "NID"
  documentUrl     String    @map("document_url")  // Secure Storage URL
  status          String    @default("PENDING")   // PENDING, VERIFIED, REJECTED
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@map("kyc_documents")
}

// 2.I.06 Table Audit Logs (To prevent drift)
model TableAuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  operation String
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("table_audit_logs")
}

// 2.C.03 Roles Enum
enum UserRole {
  SUPER_ADMIN
  ADMIN // School Owner
  HEADMASTER
  PRINCIPAL
  TEACHER
  STAFF
  STUDENT
  PARENT
  DRIVER
  AGENT
  CUSTOMER_CARE
  HOSTEL_SUPER
  LIBRARIAN
  SHOP_KEEPER
  MCM
  SUPPLIER
}

enum SubmissionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
}

// 6.B.01 Grading Logic Table
model GradingScale {
  id           String   @id @default(uuid())
  tenantId     String?  @map("school_id")
  name         String
  type         String   // Scholastic/Co-Scholastic
  isMarksBased Boolean  @default(true) @map("is_marks_based")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradingLogics GradingLogic[]

  defaultForTenants Tenant[] @relation("DefaultGradingScale")
  subjectMaps       SubjectGradingMap[]

  @@map("grading_scales")
}

model GradingLogic {
  id         String   @id @default(uuid())
  scaleId    String   @map("scale_id")
  minScore   Float?   @map("min_score")
  maxScore   Float?   @map("max_score")
  gradePoint Float    @map("grade_point")
  label      String

  scale      GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@map("grading_logics")
}

// 6.B.04 Subject Grading Map
model Subject {
  id        String   @id @default(uuid())
  tenantId  String   @map("school_id")
  name      String
  code      String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradingMaps SubjectGradingMap[]
  exams       Exam[]
  marks       StudentMark[]
  markEntryStatuses MarkEntryStatus[]

  @@unique([tenantId, name])
  @@map("subjects")
}

model SubjectGradingMap {
  id             String   @id @default(uuid())
  tenantId       String   @map("school_id")
  subjectId      String   @map("subject_id")
  classId        String?  @map("class_id")
  gradingScaleId String   @map("grading_scale_id")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@map("subject_grading_maps")
}

// 6.D.01 Student Marks & Exam
model Exam {
  id           String   @id @default(uuid())
  tenantId     String   @map("school_id")
  name         String
  classId      String   @map("class_id")
  subjectId    String   @map("subject_id")
  maxTheory    Float    @default(100) @map("max_theory")
  maxPractical Float    @default(0) @map("max_practical")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentMarks StudentMark[]
  markEntryStatus MarkEntryStatus?

  examTermId   String?       @map("exam_term_id")
  examTerm     ExamTerm?     @relation(fields: [examTermId], references: [id])
  analytics    SubjectAnalytics?

  @@map("exams")
}

model MarkEntryStatus {
  id          String           @id @default(uuid())
  examId      String           @unique @map("exam_id")
  classId     String           @map("class_id")
  subjectId   String           @map("subject_id")
  status      SubmissionStatus @default(DRAFT)
  submittedBy String?          @map("submitted_by")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, classId, subjectId])
  @@map("mark_entry_statuses")
}

model StudentMark {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  examId         String   @map("exam_id")
  subjectId      String   @map("subject_id")
  theoryMarks    Float    @default(0) @map("theory_marks")
  practicalMarks Float    @default(0) @map("practical_marks")
  totalMarks     Float    @map("total_marks")
  isAbsent       Boolean  @default(false) @map("is_absent")
  gradeLabel     String?  @map("grade_label")
  remarks        String?

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@map("student_marks")
}

// 6.E.01 Result Summary
model ExamTerm {
  id          String   @id @default(uuid())
  tenantId    String   @map("school_id")
  name        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  weightage   Float    @default(0.0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resultSummaries ResultSummary[]
  exams       Exam[]
  calculationLogs CalculationLog[]

  @@unique([tenantId, name])
  @@map("exam_terms")
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
  COMPARTMENT
}

model ResultSummary {
  id           String       @id @default(uuid())
  studentId    String       @map("student_id")
  examTermId   String       @map("exam_term_id")
  totalMarks   Float        @map("total_marks")
  percentage   Float
  classRank    Int          @map("class_rank")
  sectionRank  Int          @map("section_rank")
  resultStatus ResultStatus @map("result_status")
  calculatedAt DateTime     @default(now()) @map("calculated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examTerm     ExamTerm     @relation(fields: [examTermId], references: [id], onDelete: Cascade)

  @@unique([studentId, examTermId])
  @@map("result_summaries")
}

enum CalculationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model CalculationLog {
  id             String            @id @default(uuid())
  examTermId     String            @map("exam_term_id")
  status         CalculationStatus @default(PROCESSING)
  startedAt      DateTime          @default(now()) @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  processedCount Int               @default(0) @map("processed_count")
  errorLog       Json?             @map("error_log")

  examTerm       ExamTerm          @relation(fields: [examTermId], references: [id], onDelete: Cascade)

  @@map("calculation_logs")
}

model SubjectAnalytics {
  id          String   @id @default(uuid())
  examId      String   @unique @map("exam_id")
  average     Float
  highest     Float
  lowest      Float
  calculatedAt DateTime @default(now()) @map("calculated_at")

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("subject_analytics")
}

enum PageSize {
  A4
  LETTER
}

model MarksheetTemplate {
  id                 String   @id @default(uuid())
  tenantId           String   @map("school_id")
  name               String
  structureJson      Json     @map("structure_json")
  backgroundImageUrl String?  @map("background_image_url")
  disclaimerText     String?  @map("disclaimer_text")
  pageSize           PageSize @default(A4) @map("page_size")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes            Class[]

  @@map("marksheet_templates")
}